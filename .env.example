# Environment variables for the Claude Code cloud environment.
#
# Paste the uncommented lines into the environment's "Environment variables"
# field at claude.ai/code (see .claude/cloud/README.md). The format is .env:
# one KEY=value per line; quote values that contain "#" or span lines.
#
# Anyone who uses the environment can read these values. Never put secrets
# here: no GOOGLE_CREDENTIALS, no TF_VAR_* values, no real Teams webhook URLs.
# Those stay in GitHub Actions secrets and in your local terraform.tfvars.

# Webhook map for running the Cloud Function locally (`npm start` in src/).
# The dummy URL lets the function run end to end; the POST to Teams fails.
WEBHOOK_MAP='{"default":"https://example.invalid/webhook"}'

# Stop Terraform's version-check call to checkpoint-api.hashicorp.com
CHECKPOINT_DISABLE=1

# Make Terraform's output less chatty for non-interactive use
TF_IN_AUTOMATION=1
